    (COND B == 1 (IOPATH A O (0.124:0.225:0.225) (0.148:0.269:0.269)))
    (IOPATH B O (0.112:0.206:0.206) (0.135:0.249:0.249))
    (COND A == 0 (IOPATH B O (0.112:0.206:0.206) (0.135:0.249:0.249)))
    (COND A == 1 (IOPATH B O (0.112:0.206:0.206) (0.135:0.249:0.249)))
